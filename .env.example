# Accretion Disk Engine (ADE) — environment variable names only.
# Copy to `.env.local` for local use. Never commit secret values.

# Application
ADE_PORT=3000
ADE_APP_URL=http://localhost:3000

# Local persistence (SQLite file). Relative paths resolve from the project root.
ADE_SQLITE_PATH=./data/ade.sqlite

# Live AI content generation (Create → Generate with AI) and live AI analytics (Intelligence).
ADE_AI_PROVIDER=openai
ADE_AI_API_KEY=
ADE_AI_MODEL=gpt-4o-mini
ADE_AI_BASE_URL=https://api.openai.com/v1
ADE_AI_TIMEOUT_MS=45000

# Future Meta / Facebook (not used in ACI-002)
META_APP_ID=
META_APP_SECRET=
META_PAGE_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=

# Future third-party integrations (not used in ACI-002)
# POSTIZ_ / MIXPOST_ variables will be added only after ACI-003 harvest assessment.
